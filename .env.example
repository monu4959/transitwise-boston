# Copy this file to .env and fill in your own values. Never commit .env.

# MBTA V3 API key (free): https://api-v3.mbta.com
MBTA_KEY=

# Claude API key for plain-English trip explanations (optional: without it the
# site shows the data-only explanation)
LLM_API_KEY=

# Snowflake, key-pair login (optional for the website; needed for the pipeline,
# policy search and trip logs). See sql/01_setup.sql.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=TRANSITWISE_DB
SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/transitwise_rsa_key.p8

# AWS deployment (leave unset to run locally as above)
# LLM_PROVIDER=bedrock                         # Claude on Bedrock via the AWS role; no LLM_API_KEY
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
# TRANSITWISE_SECRET_ID=transitwise/app        # Secrets Manager JSON holding MBTA_KEY, SNOWFLAKE_*
# AGENTCORE_MEMORY_ID=                         # rider preferences in AgentCore Memory
# MCP_TRANSPORT=streamable-http                # mcp_server.py over HTTP on :8000/mcp (AgentCore Runtime)
# MCP_HOST=127.0.0.1                           # bind address for HTTP mode (0.0.0.0 in the container)
# MCP_URL=http://127.0.0.1:8000/mcp            # where agent_server.py finds the tools (Gateway on AWS)
# MCP_AUTH=sigv4                               # sign agent -> Gateway requests with AWS credentials
# OTP_TOKEN=                                   # X-OTP-Token for the EC2 token proxy (from transitwise/otp)

# OpenTripPlanner (defaults shown)
# OTP_URL=http://localhost:8080/otp/gtfs/v1
# OTP_DATA_DIR=~/transitwise-otp
